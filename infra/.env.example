DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=<postgres-password>

REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>

WARSAW_API_TOKEN=<YourTokenHere>
FETCH_INTERVAL_SECONDS=15
TIMEZONE=Europe/Warsaw
PROCESSING_STATS_ENABLED=false
REDIS_DB=0

KAFKA_CLIENT_ID=warsaw-transit
KAFKA_TOPIC_BUSES=warsaw_transit_buses_raw
KAFKA_TOPIC_TRAMS=waw_transit_trams_raw
KAFKA_TOPIC_GTFS_VERSION=waw_transit_gtfs_versions
KAFKA_STARTING_OFFSETS=latest

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:29093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,CONTROLLER://0.0.0.0:29093,PLAINTEXT_HOST://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LOG_DIRS=/tmp/kraft-combined-logs
CLUSTER_ID=<cluster-id>
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_NUM_PARTITIONS=3
