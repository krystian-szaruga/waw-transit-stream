# ==============================================================================
# WARSAW ZTM API CONFIGURATION
# ==============================================================================
# Paste your personal access token from dane.um.warszawa.pl here
WARSAW_API_TOKEN=REDACTED
FETCH_INTERVAL_SECONDS=15

# ==============================================================================
# INFRASTRUCTURE CONFIGURATION (PODMAN)
# ==============================================================================
# Local endpoints for scripts running on your host machine
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
DB_HOST=127.0.0.1
DB_PORT=5432

# ==============================================================================
# DATABASE CONFIGURATION (POSTGRESQL + POSTGIS)
# ==============================================================================
# Credentials must match the environment variables in your infrastructure.yaml
DB_USER=de_user
DB_PASSWORD=de_password
DB_NAME=warsaw_transit

# ==============================================================================
# KAFKA TOPIC SETTINGS
# ==============================================================================
KAFKA_CLIENT_ID=warsaw-bus-producer
KAFKA_TOPIC_BUSES=warsaw_transit_buses_raw
KAFKA_TOPIC_TRAMS=warsaw_transit_trams_raw

# ==============================================================================
# Optional (Local)
# ==============================================================================
JAVA_HOME=/path/to/jdk17
SPARK_LOCAL_IP=127.0.0.1
SPARK_LOCAL_HOSTNAME=localhost